{
  "name": "presentation",
  "version": "1.0.0",
  "description": "``` make install ``` ``` make serve ```",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --sourcemap --outdir=dist --entry-names=bundle --asset-names=assets/[name]-[hash] --loader:.css=css --loader:.eot=file --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --loader:.svg=file --define:THEME='\"default\"'",
    "build:print": "esbuild src/main.js --bundle --minify --sourcemap --outdir=dist --entry-names=bundle --asset-names=assets/[name]-[hash] --loader:.css=css --loader:.eot=file --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --loader:.svg=file --define:THEME='\"print\"'",
    "dev": "esbuild src/main.js --bundle --sourcemap --outdir=dist --entry-names=bundle --asset-names=assets/[name]-[hash] --loader:.css=css --loader:.eot=file --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --loader:.svg=file --watch --define:THEME='\"default\"'",
    "dev:print": "esbuild src/main.js --bundle --sourcemap --outdir=dist --entry-names=bundle --asset-names=assets/[name]-[hash] --loader:.css=css --loader:.eot=file --loader:.woff=file --loader:.woff2=file --loader:.ttf=file --loader:.svg=file --watch --define:THEME='\"print\"'",
    "serve": "concurrently -k \"npm run dev\" \"wait-on dist/bundle.js dist/bundle.css && live-server --port=${PORT:-8000} --open=./index.html\"",
    "serve:print": "concurrently -k \"npm run dev:print\" \"wait-on dist/bundle.js dist/bundle.css && live-server --port=${PORT:-8000} --open=./index.html?print-pdf\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "mermaid": "^11.17.0",
    "reveal.js": "^6.0.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "decktape": "^3.16.1",
    "esbuild": "^0.28.0",
    "live-server": "^1.2.2",
    "wait-on": "^9.0.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmiddim/reveal-js-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/schmiddim/reveal-js-boilerplate/issues"
  },
  "homepage": "https://github.com/schmiddim/reveal-js-boilerplate#readme"
}
